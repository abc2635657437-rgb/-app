.community{padding-top:28rpx}.community-head{display:flex;justify-content:space-between;align-items:center}.publish{width:72rpx;height:72rpx;line-height:68rpx;border-radius:50%;background:#173f4f;color:#fff;font-size:42rpx}.tabs{display:flex;gap:36rpx;margin:34rpx 0 18rpx;border-bottom:1rpx solid #e4e8e3}.tab{padding-bottom:16rpx;color:#8a9699;font-size:28rpx}.tab.active{color:#173f4f;font-weight:700;border-bottom:4rpx solid #d17d57}.post-card{background:#fff;border-radius:20rpx;overflow:hidden;margin-bottom:24rpx;box-shadow:0 6rpx 22rpx rgba(32,58,65,.06)}.post-image{width:100%;height:390rpx}.post-body{padding:22rpx}.author{display:flex;align-items:center;gap:14rpx}.avatar{width:64rpx;height:64rpx;border-radius:50%}.author-name{font-size:27rpx;font-weight:600}.follow{margin-left:auto;background:transparent;color:#d17d57;border:1rpx solid #d17d57;border-radius:999rpx;font-size:22rpx;padding:4rpx 18rpx}.post-title{font-size:32rpx;font-weight:700;margin-top:18rpx}.post-text{font-size:25rpx;line-height:1.5;color:#53656b;margin:8rpx 0}.tag{font-size:22rpx;color:#477064;margin-right:12rpx}.actions{display:flex;justify-content:space-between;margin-top:20rpx;color:#718087;font-size:24rpx}.route-btn{margin-top:18rpx;width:100%;background:#eef3ef;color:#173f4f;border:0;border-radius:999rpx;font-size:24rpx}