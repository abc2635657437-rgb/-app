<view class="page">
  <view class="eyebrow">TRAVEL WORLD</view>
  <view class="title">The World<br/>is Your Playground.</view>
  <view class="subtitle" style="margin-top:18rpx">真实内容、灵感路线与旅途伙伴，<br/>从下一次出发开始连接世界。</view>
  <view class="card hero-card" style="margin-top:34rpx;padding:0;overflow:hidden;position:relative">
    <image class="image" mode="aspectFill" style="height:330rpx" src="https://images.unsplash.com/photo-1500534623283-312aade485b7?w=1200" />
    <view style="position:absolute;left:26rpx;bottom:24rpx;color:#fff"><view style="font-size:34rpx;font-weight:700">下一站，去看海</view><view style="font-size:23rpx;opacity:.85;margin-top:6rpx">给自己一段不赶路的时间</view></view>
  </view>
  <view class="row" style="margin-top:24rpx"><button class="primary" bindtap="onRouteTap">开始规划路线</button><button class="outline" bindtap="onAiTap">问问 AI</button></view>
  <view class="section-head"><view class="section-title">本周灵感</view><view class="muted">更多 →</view></view>
  <scroll-view scroll-x="true" style="white-space:nowrap"><view style="display:inline-flex;width:570rpx;margin-right:18rpx" wx:for="{{featured}}" wx:key="title"><view class="card" style="width:570rpx"><image class="image" style="height:240rpx" mode="aspectFill" src="{{item.image}}"/><view class="row" style="margin-top:18rpx"><view><view style="font-size:30rpx;font-weight:700">{{item.title}}</view><view class="muted" style="margin-top:8rpx">{{item.place}}</view></view><view style="color:#d17d57;font-weight:700">{{item.cost}}</view></view></view></view></scroll-view>
  <view class="section-head"><view class="section-title">今天吃什么</view><view class="muted">按目的地探索</view></view>
  <view class="card" wx:for="{{foods}}" wx:key="name" style="margin-bottom:14rpx"><view class="row"><view><view style="font-size:28rpx;font-weight:600">{{item.name}}</view><view class="muted" style="margin-top:6rpx">{{item.place}}</view></view><text style="font-size:32rpx;color:#d17d57">↗</text></view></view>
</view>
