<view class="page community"><view class="community-head"><view><view class="eyebrow">TRAVEL WORLD</view><view class="section-title">Travel World</view><view class="muted brand-subtitle">同路人</view></view><button class="publish" bindtap="publish">＋</button></view><view class="tabs"><text wx:for="{{tabs}}" wx:key="*this" class="tab {{tab===item?'active':''}}" data-tab="{{item}}" bindtap="switchTab">{{item}}</text></view><view class="feed"><view wx:for="{{posts}}" wx:key="id" class="post-card" bindtap="open" data-title="{{item.title}}" data-type="{{item.type}}"><image class="post-image" mode="aspectFill" src="{{item.image}}"/><view class="post-body"><view class="author"><image class="avatar" src="{{item.avatar}}"/><view><view class="author-name">{{item.name}}</view><view class="muted">📍 {{item.location}}</view></view><button class="follow" catchtap="follow" data-id="{{item.userId}}">{{following[item.userId]?'已关注':'关注'}}</button></view><view class="post-title">{{item.title}}</view><view class="post-text">{{item.content}}</view><view><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view><view class="actions"><text catchtap="like" data-id="{{item.id}}">{{liked[item.id]?'♥':'♡'}} {{item.likes+(liked[item.id]?1:0)}}</text><text>💬 {{item.comments}}</text><text catchtap="save" data-id="{{item.id}}">{{saved[item.id]?'已收藏':'收藏'}}</text><text>↗ 分享</text></view><button wx:if="{{item.type==='route'}}" class="route-btn" catchtap="open" data-title="{{item.title}}" data-type="route">查看完整路线 · 复制到我的行程</button></view></view></view></view>
