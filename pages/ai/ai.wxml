<view class="page ai-page"><view class="eyebrow">TRAVEL WORLD AI</view><view class="title" style="font-size:48rpx;margin-top:8rpx">把想去的地方，<br/>变成可出发的计划。</view><view class="quick"><text class="pill" data-text="预算 3000 元去清迈 4 天" bindtap="quick">预算 3000 元去清迈 4 天</text><text class="pill" data-text="加入当地美食" bindtap="quick">加入当地美食</text></view><view class="chat"><view wx:for="{{messages}}" wx:key="index" class="bubble {{item.role}}">{{item.text}}</view></view><view wx:if="{{plan}}" class="card plan"><view class="row"><view class="section-title" style="font-size:28rpx">你的旅行草案</view><text class="pill">{{plan.days}}</text></view><view style="font-size:34rpx;font-weight:700;margin:18rpx 0 10rpx">{{plan.route}}</view><view class="muted">预算 {{plan.budget}} · 支持 Visa / 微信支付 / 现金</view><view class="plan-item" wx:for="{{plan.items}}" wx:key="*this">{{index+1}}　{{item}}</view></view><view class="composer"><input placeholder="告诉 AI 你想怎么调整..." value="{{prompt}}" bindinput="input" confirm-type="send" bindconfirm="send"/><button class="primary send" bindtap="send">发送</button></view></view>
