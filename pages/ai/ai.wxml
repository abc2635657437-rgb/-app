<view class="page ai-page"><view class="eyebrow">TRAVEL WORLD AI</view><view class="title" style="font-size:48rpx;margin-top:8rpx">把想去的地方，<br/>变成可出发的计划。</view><view class="quick"><text class="pill" data-text="预算 3000 元去清迈 4 天" bindtap="quick">预算 3000 元去清迈 4 天</text><text class="pill" data-text="加入当地美食" bindtap="quick">加入当地美食</text></view><view class="chat"><view wx:for="{{messages}}" wx:key="index" class="bubble {{item.role}}">{{item.text}}</view></view><view wx:if="{{plan}}" class="card plan"><view class="row"><view class="section-title" style="font-size:28rpx">{{plan.tripTitle}}</view><text class="pill">{{plan.days}} 天</text></view><view class="muted">预算 {{plan.currency}} {{plan.budget}} · 预计 {{plan.currency}} {{plan.estimated}}</view><view class="plan-item" wx:for="{{plan.daysPlan}}" wx:key="day" wx:for-item="day"><view style="font-weight:700">Day {{day.day}} · {{day.title}}</view><view wx:for="{{day.slots}}" wx:key="place" wx:for-item="slot" class="muted">{{slot.time}}　{{slot.place}} · {{slot.transport}} · {{plan.currency}} {{slot.cost}}</view></view></view><view class="composer"><input placeholder="告诉 AI 你想怎么调整..." value="{{prompt}}" bindinput="input" confirm-type="send" bindconfirm="send"/><button class="primary send" loading="{{loading}}" disabled="{{loading}}" bindtap="send">发送</button></view></view>
