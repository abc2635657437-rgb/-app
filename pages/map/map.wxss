.map-search{display:flex;gap:12rpx;margin:28rpx 0}.map-search input{flex:1;background:#fff;border-radius:999rpx;padding:0 24rpx;height:76rpx}.map-search button{height:76rpx;line-height:76rpx}.map-board{height:420rpx;border-radius:24rpx;background:linear-gradient(135deg,#d9eee8,#f6dfbf);position:relative;overflow:hidden;background-image:radial-gradient(#fff8 1px,transparent 1px);background-size:24rpx 24rpx}.map-dot{position:absolute;background:#fff;border-radius:50%;padding:12rpx;font-size:32rpx;box-shadow:0 4rpx 12rpx #173f4f33}.map-label{position:absolute;right:20rpx;bottom:18rpx;color:#6e8783;font-size:20rpx;letter-spacing:4rpx}.map-status{display:block;margin:14rpx 4rpx}.landmark-list{margin-bottom:14rpx}.landmark-name{font-size:29rpx;font-weight:700;color:#173f4f}
