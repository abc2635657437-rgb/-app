<view class="page"><view class="eyebrow">MAP</view><view class="title" style="font-size:48rpx">把旅行放回地图。</view><view class="map-search"><input placeholder="搜索城市或地标" value="{{query}}" bindinput="input"/><button class="primary" bindtap="search">搜索</button></view><view class="map-board"><view class="map-dot" wx:for="{{landmarks}}" wx:key="id" style="left:{{8 + index*13 % 82}}%;top:{{12 + index*17 % 72}}%" bindtap="search" data-query="{{item.name}}">{{item.icon}}</view><view class="map-label">GLOBAL MAP</view></view><view class="muted map-status">{{status}}</view><view class="card landmark-list" wx:for="{{landmarks}}" wx:key="id"><view class="row"><view><view class="landmark-name">{{item.icon}} {{item.name}}</view><view class="muted">{{item.country}} · {{item.city}}</view></view><text class="pill">{{item.bestSeason}}</text></view></view></view>
