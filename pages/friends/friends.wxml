<view class="page"><view class="eyebrow">TRAVEL</view><view class="title" style="font-size:48rpx;margin-top:8rpx">一起出发，<br/>让旅途多一个故事。</view><view class="card"><view class="section-title" style="font-size:28rpx">发布旅行计划</view><input class="input" placeholder="例如 杭州旅行 · 10月3日" data-key="title" value="{{title}}" bindinput="input"/><input class="input" placeholder="日期与集合地点" data-key="date" value="{{date}}" bindinput="input"/><textarea class="input note" placeholder="分享行程、预算和同行偏好" data-key="note" value="{{note}}" bindinput="input"></textarea><button class="primary" bindtap="publish">发布计划</button></view><view class="tabs"><view wx:for="{{tabs}}" wx:key="*this" class="tab {{tab===item?'selected':''}}" data-tab="{{item}}" bindtap="choose">{{item}}</view></view><view wx:if="{{tab==='可申请同行'}}"><view class="card" wx:for="{{plans}}" wx:key="id"><view class="row"><view><view style="font-size:28rpx;font-weight:700">{{item.title}}</view><view class="muted">{{item.date}}</view></view><text class="pill">{{item.owner}}</text></view><view class="muted" style="margin:9rpx 0">{{item.note}}</view><button wx:if="{{item.ownerId!=='local-user'}}" class="outline small" data-id="{{item.id}}" bindtap="apply">申请同行</button></view></view><view wx:if="{{tab==='我收到的申请'}}"><view class="card" wx:for="{{applications}}" wx:key="id" wx:if="{{item.ownerId==='local-user'}}"><view class="row"><b>{{item.planTitle}}</b><text class="pill">{{item.status}}</text></view><view class="muted">申请人：{{item.applicant}}</view><button wx:if="{{item.status==='待处理'}}" class="primary small" data-id="{{item.id}}" data-approved="true" bindtap="decide">同意</button><button wx:if="{{item.status==='待处理'}}" class="outline small" data-id="{{item.id}}" data-approved="false" bindtap="decide">拒绝</button></view><view wx:if="{{!applications.length}}" class="card muted">暂时没有收到的申请。</view></view><view wx:if="{{tab==='我发出的申请'}}"><view class="card" wx:for="{{applications}}" wx:key="id" wx:if="{{item.applicantId==='local-user'}}"><view class="row"><b>{{item.planTitle}}</b><text class="pill">{{item.status}}</text></view></view><view wx:if="{{!applications.length}}" class="card muted">暂时没有发出的申请。</view></view><view wx:if="{{tab==='同行聊天'}}"><view class="card" wx:for="{{chats}}" wx:key="title"><view class="row"><b>{{item.title}}</b><button class="outline small" data-title="{{item.title}}" bindtap="chat">打开聊天</button></view><view class="muted">已建立同行关系，可以讨论集合地点、交通、住宿和行程。</view></view><view wx:if="{{!chats.length}}" class="card muted">同意同行后，这里会开启对应旅行聊天。</view></view></view>
