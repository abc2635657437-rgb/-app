page { background: #f7f5f0; color: #19333d; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif; }
view, text, button, input, textarea, scroll-view { box-sizing: border-box; }
.page { padding: 36rpx 32rpx 48rpx; }
.eyebrow { color: #d17d57; font-size: 22rpx; letter-spacing: 3rpx; text-transform: uppercase; }
.title { font-size: 58rpx; line-height: 1.08; font-weight: 700; color: #173f4f; }
.subtitle { color: #75838a; font-size: 26rpx; line-height: 1.5; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin: 44rpx 0 22rpx; }
.section-title { font-size: 34rpx; font-weight: 700; color: #173f4f; }
.muted { color:#8a9699; font-size:24rpx; }
.card { background:#fff; border-radius:24rpx; padding:24rpx; box-shadow:0 8rpx 28rpx rgba(32,58,65,.06); }
.primary { background:#173f4f; color:#fff; border:0; border-radius:999rpx; padding:0 30rpx; font-size:27rpx; }
.outline { background:transparent; color:#173f4f; border:1rpx solid #b5c1c0; border-radius:999rpx; padding:0 26rpx; font-size:25rpx; }
.pill { display:inline-flex; padding:10rpx 18rpx; background:#eef3ef; color:#366052; border-radius:999rpx; font-size:22rpx; margin-right:10rpx; }
.row { display:flex; align-items:center; justify-content:space-between; }
.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.image { width:100%; border-radius:18rpx; object-fit:cover; }
