NODE_ENV=production
PORT=8787
PUBLIC_APP_URL=https://your-domain.example

# Supabase project settings. Keep these on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Optional provider keys. Never put these in index.html or miniprogram code.
GOOGLE_MAPS_SERVER_KEY=replace-me
AMAP_SERVER_KEY=replace-me
AI_API_KEY=replace-me
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1

# Replace these with SLA-backed providers before production traffic grows.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
